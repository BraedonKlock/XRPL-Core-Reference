@INCLUDE               = docs/Doxyfile

OUTPUT_DIRECTORY       = $(XCR_DOXYGEN_OUTPUT_DIRECTORY)
WARN_LOGFILE           = $(XCR_DOXYGEN_OUTPUT_DIRECTORY)/doxygen-warnings.log
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO

INPUT                  = $(XCR_DOXYGEN_INPUT)
FILE_PATTERNS          = $(XCR_DOXYGEN_FILE_PATTERNS)
EXCLUDE                =
USE_MDFILE_AS_MAINPAGE =
IMAGE_PATH             =

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = $(XCR_SOURCE_ROOT)
STRIP_FROM_INC_PATH    = $(XCR_SOURCE_ROOT)/include $(XCR_SOURCE_ROOT)/src
INCLUDE_PATH           = include src
INLINE_INHERITED_MEMB  = NO

EXPAND_ONLY_PREDEF     = YES
INCLUDE_FILE_PATTERNS  = *.macro
PREDEFINED            += XRPL_NO_SANITIZE_ADDRESS=
EXPAND_AS_DEFINED      = $(XCR_DOXYGEN_EXPAND_AS_DEFINED)

TAGFILES               =
PLANTUML_JAR_PATH      =
DOT_PATH               =
HAVE_DOT               = NO
CLASS_GRAPH            = NO
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
DIRECTORY_GRAPH        = NO
GRAPHICAL_HIERARCHY    = NO
GROUP_GRAPHS           = NO

GENERATE_HTML          = NO
SEARCHENGINE           = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
XML_NS_MEMB_FILE_SCOPE = NO

SOURCE_BROWSER         = NO
VERBATIM_HEADERS       = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO

NUM_PROC_THREADS       = 0
