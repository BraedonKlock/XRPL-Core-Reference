{
  "name": "xrpl-core-reference",
  "version": "0.1.0",
  "private": true,
  "description": "Explore the XRP Ledger's C++ Core. A community-maintained reference for the XRPLF/rippled implementation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "bash scripts/start-local.sh",
    "dev": "vite",
    "build": "vite build",
    "build:pages": "XCR_BASE_PATH=/XRPL-Core-Reference/ XCR_OUT_DIR=dist-pages vite build",
    "preview": "vite preview",
    "preview:pages": "node tests/e2e/support/static-pages-server.js dist-pages 4174 /XRPL-Core-Reference/",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "docs:extract": "node scripts/documentation/cli.js extract",
    "docs:build": "node scripts/documentation/cli.js build",
    "docs:generate": "node scripts/documentation/cli.js generate",
    "docs:validate": "node scripts/documentation/cli.js validate",
    "docs:fixtures": "node scripts/documentation/cli.js fixtures"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
