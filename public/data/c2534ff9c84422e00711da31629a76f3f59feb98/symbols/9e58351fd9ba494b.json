{"schemaVersion":"1.0.0","commitSha":"c2534ff9c84422e00711da31629a76f3f59feb98","shard":"9e58351fd9ba494b","symbols":[{"path":"xrpl/ApplyView","kind":"class","name":"ApplyView","qualifiedName":"xrpl::ApplyView","scope":"xrpl","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"Writeable view to a ledger, for applying a transaction."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"This refinement of "},{"type":"link","text":"ReadView","target":{"path":"xrpl/ReadView","resolution":"doxygen"}},{"type":"text","text":" provides an interface where the "},{"type":"link","text":"SLE","target":{"path":"xrpl/SLE","resolution":"doxygen"}},{"type":"text","text":" can be \"checked out\" for modifications and put back in an updated or removed state. Also added is an interface to provide contextual information necessary to calculate the results of transaction processing, including the metadata if the view is later applied to the parent (using an interface in the derived class). The context info also includes values from the base ledger such as sequence number and the network time."}]},{"type":"paragraph","content":[{"type":"text","text":"This allows implementations to journal changes made to the state items in a ledger, with the option to apply those changes to the base or discard the changes without affecting the base."}]},{"type":"paragraph","content":[{"type":"text","text":"Typical usage is to call "},{"type":"link","text":"read()","target":{"path":"xrpl/ReadView/read/43ad9474","resolution":"doxygen"}},{"type":"text","text":" for non-mutating operations."}]},{"type":"paragraph","content":[{"type":"text","text":"For mutating operations the sequence is as follows:"}]},{"type":"code","text":"// Add a new value\nv.insert(sle);\n\n// Check out a value for modification\nsle = v.peek(k);\n\n// Indicate that changes were made\nv.update(sle)\n\n// Or, erase the value\nv.erase(sle)"},{"type":"paragraph","content":[{"type":"text","text":"The invariant is that insert, update, and erase may not be called with any "},{"type":"link","text":"SLE","target":{"path":"xrpl/SLE","resolution":"doxygen"}},{"type":"text","text":" which belongs to different view."}]}],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/ledger/ApplyView.h","line":140},"definition":{"file":"include/xrpl/ledger/ApplyView.h","line":141,"endLine":436}},"corrections":[],"templateParameters":null,"isTemplateSpecialization":false,"isFinal":false,"isAbstract":true,"baseClasses":[{"name":"xrpl::ReadView","target":{"path":"xrpl/ReadView","resolution":"doxygen"},"access":"public","isVirtual":false}],"derivedClasses":[{"name":"xrpl::detail::ApplyViewBase","target":{"path":"xrpl/detail/ApplyViewBase","resolution":"doxygen"},"access":"public","isVirtual":false}],"friends":[],"deductionGuides":[],"nested":[],"members":["xrpl/ApplyView/update/b60d9875","xrpl/ApplyView/creditHookIOU/be9918ba","xrpl/ApplyView/creditHookMPT/1f68dce2","xrpl/ApplyView/issuerSelfDebitHookMPT/74884cad","xrpl/ApplyView/adjustOwnerCountHook/16742fcb","xrpl/ApplyView/dirAppend/ab2e6d8e","xrpl/ApplyView/dirInsert/63a1dbdc","xrpl/ApplyView/dirInsert/bc85b5c3","xrpl/ApplyView/dirRemove/6161c4d4","xrpl/ApplyView/dirRemove/78715d31","xrpl/ApplyView/dirAdd/cbba3a2a","xrpl/ApplyView/ApplyView/f4876bdc","xrpl/ApplyView/flags/888dd980","xrpl/ApplyView/peek/c7de22a0","xrpl/ApplyView/erase/627c6881","xrpl/ApplyView/insert/c3003ae5","xrpl/ApplyView/dirDelete/ef52eb77","xrpl/ApplyView/emptyDirDelete/6d5590f8"],"declaration":[{"text":"class ApplyView : public "},{"text":"xrpl::ReadView","target":{"path":"xrpl/ReadView","resolution":"doxygen"}}]},{"path":"xrpl/ApplyView/update/b60d9875","kind":"function","name":"update","qualifiedName":"xrpl::ApplyView::update","scope":"xrpl/ApplyView","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","tex