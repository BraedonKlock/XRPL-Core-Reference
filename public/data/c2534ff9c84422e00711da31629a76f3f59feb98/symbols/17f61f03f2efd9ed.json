{"schemaVersion":"1.0.0","commitSha":"c2534ff9c84422e00711da31629a76f3f59feb98","shard":"17f61f03f2efd9ed","symbols":[{"path":"xrpl/SHAMapNodeData","kind":"struct","name":"SHAMapNodeData","qualifiedName":"xrpl::SHAMapNodeData","scope":"xrpl","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"A "},{"type":"link","text":"SHAMap","target":{"path":"xrpl/SHAMap","resolution":"doxygen"}},{"type":"text","text":" is both a radix tree with a fan-out of 16 and a Merkle tree."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"A radix tree is a tree with two properties:"}]},{"type":"list","ordered":true,"items":[[{"type":"text","text":"The key for a node is represented by the node's position in the tree (the \"prefix property\")."}],[{"type":"text","text":"A node with only one child is merged with that child (the \"merge property\")"}]]},{"type":"paragraph","content":[{"type":"text","text":"These properties result in a significantly smaller memory footprint for a radix tree."}]},{"type":"paragraph","content":[{"type":"text","text":"A fan-out of 16 means that each node in the tree has at most 16 children. See "},{"type":"url","text":"https://en.wikipedia.org/wiki/Radix_tree","href":"https://en.wikipedia.org/wiki/Radix_tree"}]},{"type":"paragraph","content":[{"type":"text","text":"A Merkle tree is a tree where each non-leaf node is labelled with the hash of the combined labels of its children nodes."}]},{"type":"paragraph","content":[{"type":"text","text":"A key property of a Merkle tree is that testing for node inclusion is O(log(N)) where N is the number of nodes in the tree."}]},{"type":"paragraph","content":[{"type":"text","text":"See "},{"type":"url","text":"https://en.wikipedia.org/wiki/Merkle_tree","href":"https://en.wikipedia.org/wiki/Merkle_tree"},{"type":"text","text":" Holds a "},{"type":"link","text":"SHAMap","target":{"path":"xrpl/SHAMap","resolution":"doxygen"}},{"type":"text","text":" node's identity, leaf status, and serialized data. Used by getNodeFat to return node data for peer synchronization."}]}],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/shamap/SHAMap.h","line":104},"definition":{"file":"include/xrpl/shamap/SHAMap.h","line":105,"endLine":112}},"corrections":[],"templateParameters":null,"isTemplateSpecialization":false,"isFinal":false,"isAbstract":false,"baseClasses":[],"derivedClasses":[],"friends":[],"deductionGuides":[],"nested":[],"members":["xrpl/SHAMapNodeData/nodeID","xrpl/SHAMapNodeData/isLeaf","xrpl/SHAMapNodeData/data"],"declaration":[{"text":"struct SHAMapNodeData"}]},{"path":"xrpl/SHAMapNodeData/nodeID","kind":"variable","name":"nodeID","qualifiedName":"xrpl::SHAMapNodeData::nodeID","scope":"xrpl/SHAMapNodeData","category":"production","access":"public","documentation":{"status":"absent","brief":null,"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/shamap/SHAMap.h","line":106},"definition":{"file":"include/xrpl/shamap/SHAMap.h","line":106,"endLine":null}},"corrections":[],"type":[{"text":"SHAMapNodeID","target":{"path":"xrpl/SHAMapNodeID","resolution":"doxygen"}}],"initializer":null,"bitfield":null,"qualifiers":{"isStatic":false,"isConstexpr":false,"isMutable":false},"declaration":[{"text":"SHAMapNodeID","target":{"path":"xrpl/SHAMapNodeID","resolution":"doxygen"}},{"text":" nodeID"}]},{"path":"xrpl/SHAMapNodeData/isLeaf","kind":"variable","name":"isLeaf","qualifiedName":"xrpl::SHAMapNodeData::isLeaf","scope":"xrpl/SHAMapNodeData","category":"production","access":"public","documentation":{"status":"absent","brief":null,"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/shamap/SHAMap.h","line":110},"definition":{"file":"include/xrpl/shamap/SHAMap.h","line":110,"endLine":null}},"co