":"link","text":"Asset","target":{"path":"xrpl/Asset","resolution":"doxygen"}},{"type":"text","text":"."}]},{"type":"paragraph","content":[{"type":"text","text":"e.g. associateAsset(*loanSle, asset); associateAsset(*brokerSle, asset); associateAsset(*vaultSle, asset);"}]}],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/protocol/STNumber.h","line":41},"definition":{"file":"include/xrpl/protocol/STNumber.h","line":42,"endLine":90}},"corrections":[],"templateParameters":null,"isTemplateSpecialization":false,"isFinal":false,"isAbstract":false,"baseClasses":[{"name":"xrpl::STTakesAsset","target":{"path":"xrpl/STTakesAsset","resolution":"doxygen"},"access":"public","isVirtual":false},{"name":"xrpl::CountedObject< STNumber >","target":{"path":"xrpl/CountedObject","resolution":"doxygen"},"access":"public","isVirtual":false}],"derivedClasses":[],"friends":[],"deductionGuides":[],"nested":[],"members":["xrpl/STNumber/value_type","xrpl/STNumber/value_","xrpl/STNumber/STNumber/5b26be7d","xrpl/STNumber/STNumber/38f21a82","xrpl/STNumber/STNumber/cb7dc49e","xrpl/STNumber/getSType/0fa10d30","xrpl/STNumber/getText/5b863534","xrpl/STNumber/add/72b86742","xrpl/STNumber/value/d29d9059","xrpl/STNumber/setValue/ec2c2e3d","xrpl/STNumber/operator-assign/178f5551","xrpl/STNumber/isEquivalent/ffc2e30f","xrpl/STNumber/isDefault/dd03bb60","xrpl/STNumber/associateAsset/2491ad56","xrpl/STNumber/operator-conversion-Number/dc76a808","xrpl/STNumber/copy/e4962322","xrpl/STNumber/move/92e6823e"],"declaration":[{"text":"class STNumber : public "},{"text":"xrpl::STTakesAsset","target":{"path":"xrpl/STTakesAsset","resolution":"doxygen"}},{"text":", public "},{"text":"xrpl::CountedObject< STNumber >","target":{"path":"xrpl/CountedObject","resolution":"doxygen"}}]},{"path":"xrpl/STNumber/value_type","kind":"typeAlias","name":"value_type","qualifiedName":"xrpl::STNumber::value_type","scope":"xrpl/STNumber","category":"production","ac