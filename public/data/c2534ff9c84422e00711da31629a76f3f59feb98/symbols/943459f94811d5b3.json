{"schemaVersion":"1.0.0","commitSha":"c2534ff9c84422e00711da31629a76f3f59feb98","shard":"943459f94811d5b3","symbols":[{"path":"xrpl/ConfidentialMPTHolderKeyUpdate","kind":"class","name":"ConfidentialMPTHolderKeyUpdate","qualifiedName":"xrpl::ConfidentialMPTHolderKeyUpdate","scope":"xrpl","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"Allows a confidential MPT holder to rotate or recover their ElGamal encryption key, or to cancel a pending recovery."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"Submitted by the holder. Exactly one of three modes must be selected via the transaction flags:"}]},{"type":"list","ordered":false,"items":[[{"type":"text","text":"Rotation (tfHolderKeyRotation): the holder still has their current ElGamal private key. They provide a new public key along with their current spending/inbox balances re-encrypted under that new key. The holder's encryption key and confidential balances are updated immediately."}],[{"type":"text","text":"Recovery (tfHolderKeyRecovery): the holder has lost their current private key. They provide a new public key but cannot provide re-encrypted balances. The new key is recorded as a pending sfRecoveryKey; the confidential balances are left untouched. Completing the recovery (rewriting the balances) is done separately by the issuer via ConfidentialMPTRecoverBalance."}],[{"type":"text","text":"Cancel (tfCancelRecovery): the holder revokes a pending recovery authorization created by a prior Recovery-mode transaction. No key, balances, or proof are carried; authorization is via the holder's ordinary XRPL signature. sfRecoveryKey is removed and everything else is left untouched. Fails if no recovery is pending."}]]}],"returns":null,"notes":[{"kind":"note","content":[{"type":"text","text":"Zero-knowledge proof verification for Rotation and Recovery is deferred to a follow-up once the mpt-crypto constructions are finalized."}]}],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/tx/transactors/token/ConfidentialMPTHolderKeyUpdate.h","line":45},"definition":{"file":"include/xrpl/tx/transactors/token/ConfidentialMPTHolderKeyUpdate.h","line":46,"endLine":82}},"corrections":[],"templateParameters":null,"isTemplateSpecialization":false,"isFinal":false,"isAbstract":false,"baseClasses":[{"name":"xrpl::Transactor","target":{"path":"xrpl/Transactor","resolution":"doxygen"},"access":"public","isVirtual":false}],"derivedClasses":[],"friends":[],"deductionGuides":[],"nested":[],"members":["xrpl/ConfidentialMPTHolderKeyUpdate/kConsequencesFactory","xrpl/ConfidentialMPTHolderKeyUpdate/ConfidentialMPTHolderKeyUpdate/c16e80c2","xrpl/ConfidentialMPTHolderKeyUpdate/doApply/f2143899","xrpl/ConfidentialMPTHolderKeyUpdate/visitInvariantEntry/3d1be995","xrpl/ConfidentialMPTHolderKeyUpdate/finalizeInvariants/df9014f2","xrpl/ConfidentialMPTHolderKeyUpdate/checkExtraFeatures/4c81f432","xrpl/ConfidentialMPTHolderKeyUpdate/getFlagsMask/ca4f85e0","xrpl/ConfidentialMPTHolderKeyUpdate/preflight/7eeeb11f","xrpl/ConfidentialMPTHolderKeyUpdate/calculateBaseFee/eb9f0d14","xrpl/ConfidentialMPTHolderKeyUpdate/preclaim/e2aabf10"],"declaration":[{"text":"class ConfidentialMPTHolderKeyUpdate : public "},{"text":"xrpl::Transactor","target":{"path":"xrpl/Transactor","resolution":"doxygen"}}]},{"path":"xrpl/ConfidentialMPTHolderKeyUpdate/kConsequencesFactory","kind":"variable","name":"kConsequencesFactory","qualifiedName":"xrpl::ConfidentialMPTHolderKeyUpdate::kConsequencesFactory","scope":"xrpl/ConfidentialMPTHolderKeyUpdate","category":"production","access":"public","documentation":{"status":"absent","brief":null,"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/tx/transactors/token/ConfidentialMPTHolderKeyUpdate.h","line":48},"definition":{"file":"include/xrpl/tx/transactors/token/ConfidentialMPTHolderKeyUp