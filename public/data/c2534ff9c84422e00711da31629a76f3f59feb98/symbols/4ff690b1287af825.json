{"schemaVersion":"1.0.0","commitSha":"c2534ff9c84422e00711da31629a76f3f59feb98","shard":"4ff690b1287af825","symbols":[{"path":"xrpl/InvariantChecker_PROTOTYPE","kind":"class","name":"InvariantChecker_PROTOTYPE","qualifiedName":"xrpl::InvariantChecker_PROTOTYPE","scope":"xrpl","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"Prototype for invariant check implementations."}],"description":[{"type":"paragraph","content":[{"type":"strong","text":"THIS CLASS DOES NOT EXIST"},{"type":"text","text":" - or rather it exists in documentation only to communicate the interface required of any invariant checker. Any invariant check implementation should implement the public methods documented here."}]},{"type":"paragraph","content":[{"type":"strong","text":"Rules for implementing finalize"}]},{"type":"paragraph","content":[{"type":"strong","text":"Invariants must run regardless of transaction result"}]},{"type":"paragraph","content":[{"type":"text","text":"An invariant's "},{"type":"code","text":"finalize"},{"type":"text","text":" method MUST perform meaningful checks even when the transaction has failed (i.e., "},{"type":"code","text":"!isTesSuccess(tec)"},{"type":"text","text":"). The following pattern is almost certainly wrong and must never be used:"}]},{"type":"code","text":"// WRONG: skipping all checks on failure defeats the purpose of invariants\n\nif (!isTesSuccess(tec))\n\n    return true;"},{"type":"paragraph","content":[{"type":"text","text":"The entire purpose of invariants is to detect and prevent the impossible. A bug or exploit could cause a failed transaction to mutate ledger state in unexpected ways. Invariants are the last line of defense against such scenarios."}]},{"type":"paragraph","content":[{"type":"text","text":"In general: an invariant that expects a domain-specific state change to occur (e.g., a new object being created) should only expect that change when the transaction succeeded. A failed "},{"type":"link","text":"VaultCreate","target":{"path":"xrpl/VaultCreate","resolution":"doxygen"}},{"type":"text","text":" must not have created a Vault. A failed "},{"type":"link","text":"LoanSet","target":{"path":"xrpl/LoanSet","resolution":"doxygen"}},{"type":"text","text":" must not have created a Loan."}]},{"type":"paragraph","content":[{"type":"text","text":"Also be aware that failed transactions, regardless of type, carry no Privileges. Any privilege-gated checks must therefore also be applied to failed transactions."}]}],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/tx/invariants/InvariantCheck.h","line":72},"definition":{"file":"include/xrpl/tx/invariants/InvariantCheck.h","line":73,"endLine":119}},"corrections":[],"templateParameters":null,"isTemplateSpecialization":false,"isFinal":false,"isAbstract":false,"baseClasses":[],"derivedClasses":[],"friends":[],"deductionGuides":[],"nested":[],"members":["xrpl/InvariantChecker_PROTOTYPE/InvariantChecker_PROTOTYPE/505329d6","xrpl/InvariantChecker_PROTOTYPE/visitEntry/6eede5b8","xrpl/InvariantChecker_PROTOTYPE/finalize/2fb77155"],"declaration":[{"text":"class InvariantChecker_PROTOTYPE"}]},{"path":"xrpl/InvariantChecker_PROTOTYPE/InvariantChecker_PROTOTYPE/505329d6","kind":"function","name":"InvariantChecker_PROTOTYPE","qualifiedName":"xrpl::InvariantChecker_PROTOTYPE::InvariantChecker_PROTOTYPE","scope":"xrpl/InvariantChecker_PROTOTYPE","category":"production","access":"public","documentation":{"status":"absent","brief":null,"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/tx/invariants/InvariantCheck.h","line":75},"definition":null},"corrections":[],"role":"constructor","overloadSet":"xrpl/InvariantChecker_PROTOTYPE/InvariantChecker_PROTOTYPE","signatureKey":"xrpl::InvariantChecker_PROTOTYPE::InvariantChecker_PROTOTYPE()","returnType":null,"parameters":[],"templateParameters":null,"requiresClause":null,"explicitSpecializations":[],"qualifiers":{"isStatic":false,"isConst":false,"isConstexpr":false,"isConsteval":false,"isExplicit":true,"isInline":false,"isNoexcept":false,"isNodiscard":false,"isDeleted":false,"isDefaulted":true,"isPureVirtual":false,"isOverride":false,"isFinal":false,"virtuality":"non-virtual","referenceQualifier":null},"declaration":[{"text":"explicit InvariantChecker_PROTOTYPE() = default"}]},{"path":"xrpl/InvariantChecker_PROTOTYPE/visitEntry/6eede5b8","kind":"function","name":"visitEntry","qualifiedName":"xrpl::InvariantChecker_PROTOTYPE::visitEntry","scope":"xrpl/InvariantChecker_PROTOTYPE","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"called for each ledger entry in the current transaction."}],"description":[],"returns":null,"notes":[{"kind":"note","content":[{"type":"code","text":"after"},{"type":"text","text":" IS NEVER NULL. "},{"type":"code","text":"isDelete"},{"type":"text","text":" is the only correct way to check for deletions. Do not make logic or branching decisions on whether on "},{"type":"code","text":"after"},{"type":"text","text":" is set, because it will always be set. Treat a null "},{"type":"code","text":"after"},{"type":"text","text":" as a programming error (with XRPL_ASSERT). An invariant MAY check for null defensively, if it makes more sense, but an assertion is preferred for new invariants."}]}],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/tx/invariants/InvariantCheck.h","line":94},"definition":null},"corrections":[],"role":"method","overloadSet":"xrpl/InvariantChecker_PROTOTYPE/visitEntry","signatureKey":"xrpl::InvariantChecker_PROTOTYPE::visitEntry(bool,SLE::ConstRef,SLE::ConstRef)","returnType":[{"text":"void"}],"parameters":[{"name":"isDelete","type":[{"text":"bool"}],"array":null,"defaultValue":null,"description":[{"type":"text","text":"true if the "},{"type":"link","text":"SLE","target":{"path":"xrpl/SLE","resolution":"doxygen"}},{"type":"text","text":" is being deleted."}],"direction":null},{"name":"before","type":[{"text":"SLE::ConstRef","target":{"path":"xrpl/STLedgerEntry/ConstRef","resolution":"doxygen"}}],"array":null,"defaultValue":null,"description":[{"type":"text","text":"ledger entry before modification by the transaction. "},{"type":"code","text":"before"},{"type":"text","text":" will be null if the entry is new."}],"direction":null},{"name":"after","type":[{"text":"SLE::ConstRef","target":{"path":"xrpl/STLedgerEntry/ConstRef","resolution":"doxygen"}}],"array":null,"defaultValue":null,"description":[{"type":"text","text":"ledger entry after modification by the transaction. Always non-null. When deleting, "},{"type":"code","text":"after"},{"type":"text","text":" may differ from "},{"type":"code","text":"before"},{"type":"text","text":". Whether that is important is up to the individual invariant check."}],"direction":null}],"templateParameters":null,"requiresClause":null,"explicitSpecializations":[],"qualifiers":{"isStatic":false,"isConst":false,"isConstexpr":false,"isConsteval":false,"isExplicit":false,"isInline":false,"isNoexcept":false,"isNodiscard":false,"isDeleted":false,"isDefaulted":false,"isPureVirtual":false,"isOverride":false,"isFinal":false,"virtuality":"non-virtual","referenceQualifier":null},"declaration":[{"text":"void visitEntry(bool isDelete, "},{"text":"SLE::ConstRef","target":{"path":"xrpl/STLedgerEntry/ConstRef","resolution":"doxygen"}},{"text":" before, "},{"text":"SLE::ConstRef","target":{"path":"xrpl/STLedgerEntry/ConstRef","resolution":"doxygen"}},{"text":" after)"}]},{"path":"xrpl/InvariantChecker_PROTOTYPE/finalize/2fb77155","kind":"function","name":"finalize","qualifiedName":"xrpl::InvariantChecker_PROTOTYPE::finalize","scope":"xrpl/InvariantChecker_PROTOTYPE","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"called after all ledger entries have been visited to determine the final status of the check."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"This method MUST perform meaningful checks even when "},{"type":"code","text":"tec"},{"type":"text","text":" indicates a failed transaction. See the class-level documentation for the rules governing how failed transactions must be handled."}]}],"returns":[{"type":"text","text":"true if check passes, false if it fails"}],"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/tx/invariants/InvariantCheck.h","line":113},"definition":null},"corrections":[],"role":"method","overloadSet":"xrpl/InvariantChecker_PROTOTYPE/finalize","signatureKey":"xrpl::InvariantChecker_PROTOTYPE::finalize(STTx const&,TER const,XRPAmount const,ReadView const&,beast::Journal const&)","returnType":[{"text":"bool"}],"parameters":[{"name":"tx","type":[{"text":"STTx","target":{"path":"xrpl/STTx","resolution":"doxygen"}},{"text":" const&"}],"array":null,"defaultValue":null,"description":[{"type":"text","text":"the transaction being applied"}],"direction":null},{"name":"tec","type":[{"text":"TER","target":{"path":"xrpl/TER","resolution":"doxygen"}},{"text":" const"}],"array":null,"defaultValue":null,"description":[{"type":"text","text":"the current "},{"type":"link","text":"TER","target":{"path":"xrpl/TER","resolution":"doxygen"}},{"type":"text","text":" result of the transaction"}],"direction":null},{"name":"fee","type":[{"text":"XRPAmount","target":{"path":"xrpl/XRPAmount","resolution":"doxygen"}},{"text":" const"}],"array":null,"defaultValue":null,"description":[{"type":"text","text":"the fee actually charged for this transaction"}],"direction":null},{"name":"view","type":[{"text":"ReadView","target":{"path":"xrpl/ReadView","resolution":"doxygen"}},{"text":" const&"}],"array":null,"defaultValue":null,"description":[{"type":"text","text":"a "},{"type":"link","text":"ReadView","target":{"path":"xrpl/ReadView","resolution":"doxygen"}},{"type":"text","text":" of the ledger being modified"}],"direction":null},{"name":"j","type":[{"text":"beast::Journal","target":{"path":"beast/Journal","resolution":"doxygen"}},{"text":" const&"}],"array":null,"defaultValue":null,"description":[{"type":"text","text":"journal for logging"}],"direction":null}],"templateParameters":null,"requiresClause":null,"explicitSpecializations":[],"qualifiers":{"isStatic":false,"isConst":false,"isConstexpr":false,"isConsteval":false,"isExplicit":false,"isInline":false,"isNoexcept":false,"isNodiscard":false,"isDeleted":false,"isDefaulted":false,"isPureVirtual":false,"isOverride":false,"isFinal":false,"virtuality":"non-virtual","referenceQualifier":null},"declaration":[{"text":"bool finalize("},{"text":"STTx","target":{"path":"xrpl/STTx","resolution":"doxygen"}},{"text":" const& tx, "},{"text":"TER","target":{"path":"xrpl/TER","resolution":"doxygen"}},{"text":" const tec, "},{"text":"XRPAmount","target":{"path":"xrpl/XRPAmount","resolution":"doxygen"}},{"text":" const fee, "},{"text":"ReadView","target":{"path":"xrpl/ReadView","resolution":"doxygen"}},{"text":" const& view, "},{"text":"beast::Journal","target":{"path":"beast/Journal","resolution":"doxygen"}},{"text":" const& j)"}]}]}
