{"schemaVersion":"1.0.0","commitSha":"c2534ff9c84422e00711da31629a76f3f59feb98","shard":"93a242b4357b4fb3","symbols":[{"path":"xrpl/AMMLiquidity","kind":"class","name":"AMMLiquidity","qualifiedName":"xrpl::AMMLiquidity","scope":"xrpl","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"link","text":"AMMLiquidity","target":{"path":"xrpl/AMMLiquidity","resolution":"doxygen"}},{"type":"text","text":" class provides AMM offers to "},{"type":"link","text":"BookStep","target":{"path":"xrpl/BookStep","resolution":"doxygen"}},{"type":"text","text":" class."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"The offers are generated in two ways. If there are multiple paths specified to the payment transaction then the offers are generated based on the Fibonacci sequence with a limited number of payment engine iterations consuming AMM offers. These offers behave the same way as CLOB offers in that if there is a limiting step, then the offers are adjusted based on their quality. If there is only one path specified in the payment transaction then the offers are generated based on the competing CLOB offer quality. In this case the offer's size is set in such a way that the new AMM's pool spot price quality is equal to the CLOB's offer quality."}]}],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/tx/paths/AMMLiquidity.h","line":35},"definition":{"file":"include/xrpl/tx/paths/AMMLiquidity.h","line":36,"endLine":134}},"corrections":[],"templateParameters":[{"type":[{"text":"typename TIn"}],"name":null,"defaultValue":null},{"type":[{"text":"typename TOut"}],"name":null,"defaultValue":null}],"isTemplateSpecialization":false,"isFinal":false,"isAbstract":false,"baseClasses":[],"derivedClasses":[],"friends":[],"deductionGuides":[],"nested":[],"members":["xrpl/AMMLiquidity/kInitialFibSeqPct","xrpl/AMMLiquidity/ammContext_","xrpl/AMMLiquidity/ammAccountI