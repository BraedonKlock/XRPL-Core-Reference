":"doxygen"}},{"text":" const& ledger) const"}]},{"path":"xrpl/LedgerTrie/getPreferred/5b1023b0","kind":"function","name":"getPreferred","qualifiedName":"xrpl::LedgerTrie::getPreferred","scope":"xrpl/LedgerTrie","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"Return the preferred ledger "},{"type":"link","text":"ID","target":{"path":"xrpl/LedgerTrie/ID","resolution":"doxygen"}},{"type":"text","text":"."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"The preferred ledger is used to determine the working ledger for consensus amongst competing alternatives."}]},{"type":"paragraph","content":[{"type":"text","text":"Recall that each validator is normally validating a chain of ledgers, e.g. A->B->C->D. However, if due to network connectivity or other issues, validators generate different chains"}]},{"type":"code","text":"    /->C\n\nA->B\n\n    \\->D->E"},{"type":"paragraph","content":[{"type":"text","text":"we need a way for validators to converge on the chain with the most support. We call this the preferred ledger. Intuitively, the idea is to be conservative and only switch to a different branch when you see enough peer validations to "},{"type":"emphasis","text":"know"},{"type":"text","text":" another branch won't have preferred support."}]},{"type":"paragraph","content":[{"type":"text","text":"The preferred ledger is found by walking this tree of validated ledgers starting from the common ancestor ledger."}]},{"type":"paragraph","content":[{"type":"text","text":"At each sequence number, we have"}]},{"type":"list","ordered":false,"items":[[{"type":"text","text":"The prior sequence preferred ledger, e.g. B."}],[{"type":"text","text":"The (tip) support of ledgers with this sequence number,e.g. the number of validators whose last validation was for C or D."}],[{"type":"text","text":"The (branch) total support of all descendants of the current sequence number ledgers, e.g. the branch support of D is the tip support of D plus the tip support of E; the branch support of C is just the tip support of C."}],[{"type":"text","text":"The number of validators that have yet to validate a ledger with this sequence number (uncommitted support). Uncommitted includes all validators whose last sequence number is smaller than our last issued sequence number, since due to asynchrony, we may not have heard from those nodes yet."}]]},{"type":"paragraph","content":[{"type":"text","text":"The preferred ledger for this sequence number is then the ledger with relative majority of support, where uncommitted support can be given to ANY ledger at that sequence number (including one not yet known). If no such preferred ledger exists, then the prior sequence preferred ledger is the overall preferred ledger."}]},{"type":"paragraph","content":[{"type":"text","text":"In this example, for D to be preferred, the number of validators supporting it or a descendant must exceed the number of validators supporting C "},{"type":"emphasis","text":"plus"},{"type":"text","text":" the current uncommitted support. This is because if all uncommitted validators end up validating C, that new support must be less than that for D to be preferred."}]},{"type":"paragraph","content":[{"type":"text","text":"If a preferred ledger does exist, then we continue with the next sequence using that ledger as the root."}]}],"returns":[{"type":"text","text":"Pair with the sequence number and "},{"type":"link","text":"ID","target":{"path":"xrpl/LedgerTrie/ID","resolution":"doxygen"}},{"type":"text","text":" of the preferred ledger or std::nullopt if no preferred ledger exists"}],"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/consensus/LedgerTrie.h","line":672},"definition":{"file":"include/xrpl/consensus/LedgerTrie.h","line":672,"endLine":770}},"corrections":[],"role":"method","overloadSet":"xrpl/LedgerTrie/getPreferred","signatureKey":"xrpl::LedgerTrie::getPreferred(Seq const)const","returnType":[{"text":"std::optional<"},{"text":"SpanTip","target":{"path":"xrpl/SpanTip","resolution":"doxygen"}},{"text":"<"},{"text":"Ledger","target":{"path":"xrpl/Ledger","resolution":"doxygen"}},{"text":">>"}],"parameters":[{"name":"largestIssued","type":[{"text":"Seq","target":{"path":"xrpl/LedgerTrie/Seq","resolution":"doxygen"}},{"text":" const"}],"array":null,"defaultValue":null,"description":[{"type":"text","text":"The sequence number of the largest validation issued by this node."}],"direction":null}],"templateParameters":null,"requiresClause":null,"explicitSpecializations":[],"qualifiers":{"isStatic":false,"isConst":true,"isConstexpr":false,"isConsteval":false,"isExplicit":false,"isInline":true,"isNoexcept":false,"isNodiscard":true,"isDeleted":false,"isDefaulted":false,"isPureVirtual":false,"isOverride":false,"isFinal":false,"virtuality":"non-virtual","referenceQualifier":null},"declaration":[{"text":"[[nodiscard]]\nstd::optional<"},{"text":"SpanTip","target":{"path":"xrpl/SpanTip","resolution":"doxygen"}},{"text":"<"},{"text":"Ledger","target":{"path":"xrpl/Ledger","resolution":"doxygen"}},{"text":">> getPreferred("},{"text":"Seq","target":{"path":"xrpl/LedgerTrie/Seq","resolution":"doxygen"}},{"text":" const largestIssued) const"}]},{"path":"xrpl/LedgerTrie/empty/4ef3c25f","kind":"function","name":"empty","qualifiedName":"xrpl::LedgerTrie::empty","scope":"xrpl/LedgerTrie","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"Return whether the trie is tracking any ledgers."}],"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/consensus/LedgerTrie.h","line":776},"definition":{"file":"include/xrpl/consensus/LedgerTrie.h","line":776,"endLine":779}},"corrections":[],"role":"method","overloadSet":"xrpl/LedgerTrie/empty","signatureKey":"xrpl::LedgerTrie::empty()const","returnType":[{"t