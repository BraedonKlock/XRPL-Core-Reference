{"schemaVersion":"1.0.0","commitSha":"c2534ff9c84422e00711da31629a76f3f59feb98","shard":"192a397e76aaa1d9","symbols":[{"path":"xrpl/TrustedVotes","kind":"class","name":"TrustedVotes","qualifiedName":"xrpl::TrustedVotes","scope":"xrpl","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"link","text":"TrustedVotes","target":{"path":"xrpl/TrustedVotes","resolution":"doxygen"}},{"type":"text","text":" records the most recent votes from trusted validators."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"We keep a record in an effort to avoid \"flapping\" while amendment voting is in process."}]},{"type":"paragraph","content":[{"type":"text","text":"If a trusted validator loses synchronization near a flag ledger their amendment votes may be lost during that round. If the validator is a bit flaky, then this can cause an amendment to appear to repeatedly gain and lose support."}]},{"type":"paragraph","content":[{"type":"link","text":"TrustedVotes","target":{"path":"xrpl/TrustedVotes","resolution":"doxygen"}},{"type":"text","text":" addresses the problem by holding on to the last vote seen from every trusted validator. So if any given validator is off line near a flag ledger we can assume that they did not change their vote."}]},{"type":"paragraph","content":[{"type":"text","text":"If we haven't seen any STValidations from a validator for several hours we lose confidence that the validator hasn't changed their position. So there's a timeout. We remove upVotes if they haven't been updated in several hours."}]}],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/app/misc/detail/AmendmentTable.cpp","line":107},"definition":{"file":"src/xrpld/app/misc/detail/AmendmentTable.cpp","line":108,"endLine":286}},"corrections":[],"templateParameters":null,"isTemplateSpecialization":false,"isFinal":false,"isAbstract":false,"baseClasses":[],"derivedClasses"