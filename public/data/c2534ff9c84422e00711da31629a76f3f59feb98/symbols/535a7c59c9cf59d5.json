{"schemaVersion":"1.0.0","commitSha":"c2534ff9c84422e00711da31629a76f3f59feb98","shard":"535a7c59c9cf59d5","symbols":[{"path":"beast/Zero","kind":"struct","name":"Zero","qualifiedName":"beast::Zero","scope":"beast","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"link","text":"Zero","target":{"path":"beast/Zero","resolution":"doxygen"}},{"type":"text","text":" allows classes to offer efficient comparisons to zero."}],"description":[{"type":"paragraph","content":[{"type":"link","text":"Zero","target":{"path":"beast/Zero","resolution":"doxygen"}},{"type":"text","text":" is a struct to allow classes to efficiently compare with zero without requiring an rvalue construction."}]},{"type":"paragraph","content":[{"type":"text","text":"It's often the case that we have classes which combine a number and a unit. In such cases, comparisons like t > 0 or t != 0 make sense, but comparisons like t > 1 or t != 1 do not."}]},{"type":"paragraph","content":[{"type":"text","text":"The class "},{"type":"link","text":"Zero","target":{"path":"beast/Zero","resolution":"doxygen"}},{"type":"text","text":" allows such comparisons to be easily made."}]},{"type":"paragraph","content":[{"type":"text","text":"The comparing class T either needs to have a method called "},{"type":"link","text":"signum()","target":{"path":"beast/signum/d9b9cd2d","resolution":"doxygen"}},{"type":"text","text":" which returns a positive number, 0, or a negative; or there needs to be a signum function which resolves in the namespace which takes an instance of T and returns a positive, zero or negative number."}]}],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/beast/utility/Zero.h","line":25},"definition":{"file":"include/xrpl/beast/utility/Zero.h","line":26,"endLine":28}},"corrections":[],"templateParameters":null,"isTemplateSpecialization":false,"isFinal":false,"isAbstract":false,"baseClasses":[],"derivedClasses":[],"friends":[],"deductionGuides":[],"nested":[],"members":["beast/Zero/Zero/1f83c45f"],"declaration":[{"text":"struct Zero"}]},{"path":"beast/Zero/Zero/1f83c45f","kind":"function","name":"Zero","qualifiedName":"beast::Zero::Zero","scope":"beast/Zero","category":"production","access":"public","documentation":{"status":"absent","brief":null,"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/beast/utility/Zero.h","line":27},"definition":null},"corrections":[],"role":"constructor","overloadSet":"beast/Zero/Zero","signatureKey":"beast::Zero::Zero()","returnType":null,"parameters":[],"templateParameters":null,"requiresClause":null,"explicitSpecializations":[],"qualifiers":{"isStatic":false,"isConst":false,"isConstexpr":false,"isConsteval":false,"isExplicit":true,"isInline":false,"isNoexcept":false,"isNodiscard":false,"isDeleted":false,"isDefaulted":true,"isPureVirtual":false,"isOverride":false,"isFinal":false,"virtuality":"non-virtual","referenceQualifier":null},"declaration":[{"text":"explicit Zero() = default"}]}]}
