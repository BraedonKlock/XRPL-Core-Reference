me":"xrpl::WarningCodeI","scope":"xrpl","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"Codes returned in the "},{"type":"code","text":"warnings"},{"type":"text","text":" array of certain RPC commands."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"These values need to remain stable."}]}],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/protocol/ErrorCodes.h","line":157},"definition":{"file":"include/xrpl/protocol/ErrorCodes.h","line":157,"endLine":164}},"corrections":[],"isScoped":false,"underlyingType":null,"enumerators":[{"name":"WarnRpcUnsupportedMajority","initializer":[{"text":"= 1001"}],"documentation":{"status":"absent","brief":null,"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null}},{"name":"WarnRpcAmendmentBlocked","initializer":[{"text":"= 1002"}],"documentation":{"status":"absent","brief":null,"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null}},{"name":"WarnRpcExpiredValidatorList","initializer":[{"text":"= 1003"}],"documentation":{"status":"absent","brief":null,"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null}},{"name":"WarnRpcFieldsDeprecated","initializer":[{"text":"= 2004"}],"documentation":{"status":"absent","brief":null,"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null}}],"declaration":[{"text":"enum WarningCodeI"}]},{"path":"xrpl/WithdrawAll","kind":"enum","name":"WithdrawAll","qualifiedName":"xrpl::WithdrawAll","scope":"xrpl","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"link","text":"AMMWithdraw","target":{"path":"xrpl/AMMWithdraw","resolution":"doxygen"}},{"type":"text","text":" implements AMM withdraw "},{"type":"link","text":"Transactor","target":{"path":"xrpl/Transactor","resolution":"doxygen"}},{"type":"text","text":"."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"The withdraw transaction is used to remove liquidity from the AMM instance pool, thus redeeming some share of the pools that one owns in the form of LPTokens. If the trader withdraws proportional values of both assets without changing their relative pricing, no trading fee is charged on the transaction. The trader can specify different combination of the fields in the withdrawal. LPTokens - transaction assumes proportional withdrawal of pool assets for the amount of LPTokens. Asset1Out - transaction assumes withdrawal of single asset equivalent to the amount specified in Asset1Out. Asset1Out and Asset2Out - transaction assumes all assets withdrawal with the constraints on the maximum amount of each asset that the trader is willing to withdraw. Asset1Out and LPTokens - transaction assumes withdrawal of single asset specified in Asset1Out proportional to the share represented by the amount of LPTokens. Asset1Out and EPrice - transaction assumes withdrawal of single asset with the following constraints: a. Amount of asset1 if specified (not 0) in Asset1Out specifies the minimum amount of asset1 that the trader is willing to withdraw. b. The effective price of asset traded out does not exceed the amount specified in EPrice. Following updates after a successful transaction: The withdrawn asset, if XRP, is transferred from AMM instance account to the account that initiated the transaction, thus changing the Balance field of each account. The withdrawn asset, if token, is balanced between the AMM instance account and the issuer account. The LPTokens ~ are balanced between the AMM instance account and the account that initiated the transaction. The pool composition is updated."}]}],"returns":null,"notes":[{"kind":"see","content":[{"type":"url","text":"XLS30d:AMMWithdraw transaction","href":"https://github.com/XRPLF/XRPL-Standards/discussions/78"}]}],"suppressionRea