 bits you need to generate new default DH parameters and update defaultDH accordingly."}]}],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/libxrpl/basics/make_SSLContext.cpp","line":50},"definition":{"file":"src/libxrpl/basics/make_SSLContext.cpp","line":50,"endLine":null}},"corrections":[],"type":[{"text":"int"}],"initializer":[{"text":"= 2048"}],"bitfield":null,"qualifiers":{"isStatic":false,"isConstexpr":false,"isMutable":false},"declaration":[{"text":"int gDefaultRsaKeyBits = 2048"}]},{"path":"xrpl/openssl/detail/kDefaultDh","kind":"variable","name":"kDefaultDh","qualifiedName":"xrpl::openssl::detail::kDefaultDh","scope":"xrpl/openssl/detail","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"The default DH parameters."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"These were generated using the OpenSSL command: "},{"type":"code","text":"openssl dhparam 2048"},{"type":"text","text":" by Nik Bougalis nikb@bougalis.net on May, 29, 2022."}]},{"type":"paragraph","content":[{"type":"text","text":"It is safe to use this, but if you want you can generate different parameters and put them here. There's no easy way to change this via the config file at this time."}]}],"returns":null,"notes":[{"kind":"note","content":[{"type":"text","text":"If you increase the number of bits you need to update defaultRSAKeyBits accordingly."}]}],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/libxrpl/basics/make_SSLContext.cpp","line":65},"definition":{"file":"src/libxrpl/basics/make_SSLContext.cpp","line":65,"endLine":null}},"corrections":[],"type":[{"text":"char"}],"initializer":[{"text":"= \"-----BEGIN DH PARAMETERS-----\\n\" \"MIIBCAKCAQEApKSWfR7LKy0VoZ/SDCObCvJ5HKX2J93RJ+QN8kJwHh+uuA8G+t8Q\\n\" \"MDRjL5HanlV/sKN9HXqBc7eqHmmbqYwIXKUt9MUZTLNheguddxVlc2IjdP5i9Ps8\\n\" \"l7su8tnP0l1JvC6Rfv3epRsEAw/ZW/lC2IwkQPpOmvnENQhQ6TgrUzcGkv4