{"schemaVersion":"1.0.0","commitSha":"c2534ff9c84422e00711da31629a76f3f59feb98","shard":"3fa39d018b445928","symbols":[{"path":"xrpl/ConfidentialMPTMirrorUpdate","kind":"class","name":"ConfidentialMPTMirrorUpdate","qualifiedName":"xrpl::ConfidentialMPTMirrorUpdate","scope":"xrpl","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"Updates the encrypted mirror balances of a Confidential MPToken."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"This transaction updates a single holder's mirrored confidential balances ("},{"type":"code","text":"sfIssuerEncryptedBalance"},{"type":"text","text":" and/or "},{"type":"code","text":"sfAuditorEncryptedBalance"},{"type":"text","text":") with the latest ElGamal public keys defined on the "},{"type":"code","text":"MPTokenIssuance"},{"type":"text","text":"."}]},{"type":"paragraph","content":[{"type":"text","text":"It supports both issuer and holder self-migration modes, each mode supports multiple flows:"}]},{"type":"list","ordered":false,"items":[[{"type":"text","text":"Issuer mode: Submitted by the issuer."}]]},{"type":"list","ordered":true,"items":[[{"type":"text","text":"Issuer Key Rotation Migration: Re-encrypts the holder's "},{"type":"code","text":"sfIssuerEncryptedBalance"},{"type":"text","text":" under the issuer's new ElGamal public key."}],[{"type":"text","text":"Auditor Key Rotation Migration: Re-encrypts the holder's "},{"type":"code","text":"sfAuditorEncryptedBalance"},{"type":"text","text":" under the auditor's new ElGamal public key."}],[{"type":"text","text":"Simultaneous Rotation Migration: Updates both the issuer and auditor encrypted balances in a single transaction to optimize network throughput."}],[{"type":"text","text":"Auditor Late-Registration Migration: When the issuer ElGamal public key is already registered on the "},{"type":"code","text":"MPTokenIssuance"},{"type":"text","text":" object, the issuer can register an auditor key at a later time through "},{"type":"code","text":"MPTokenIssuanceSet"},{"type":"text","text":". Then the issuer uses this flow to set the holder's initial "},{"type":"code","text":"sfAuditorEncryptedBalance"},{"type":"text","text":" on "},{"type":"code","text":"MPToken"},{"type":"text","text":" object."}]]},{"type":"list","ordered":false,"items":[[{"type":"text","text":"Holder self-migration mode: Submitted by the holder. The holder decrypts their own "},{"type":"code","text":"sfConfidentialBalanceSpending"},{"type":"text","text":" with holder's private key to recover the balance and re-encrypts it under the relevant new ElGamal public key(s). This mode is always available to the holder and is not conditioned on the issuer being unable to migrate them: the ledger cannot verify whether an issuer has really lost its private key. That loss is only the expected motivation, since an issuer that still holds its key can migrate holders itself in issuer mode."}]]},{"type":"list","ordered":true,"items":[[{"type":"text","text":"Holder Issuer-Mirror Migration: Re-encrypts the holder's "},{"type":"code","text":"sfIssuerEncryptedBalance"},{"type":"text","text":" under the issuer's new ElGamal public key."}],[{"type":"text","text":"Holder Auditor-Mirror Migration: Re-encrypts the holder's "},{"type":"code","text":"sfAuditorEncryptedBalance"},{"type":"text","text":" under the auditor's new ElGamal public key, or sets it for the first time when the auditor key was late-registered. This is the holder-driven counterpart to flows 2 and 4, for when the issuer does not migrate the holder itself."}],[{"type":"text","text":"Simultaneous Holder Self-Migration: Updates both the issuer and auditor encrypted balances in a single transaction (both keys have rotated)."}]]}],"returns":null,"notes":[{"kind":"note","content":[{"type":"text","text":"All holder migration flows strictly require the holder's "},{"type":"code","text":"sfConfidentialBalanceInbox"},{"type":"text","text":" to be canonically zero; the holder must run "},{"type":"code","text":"ConfidentialMPTMergeInbox"},{"type":"text","text":" first so the spending balance reflects the full balance."}]}],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/tx/transactors/token/ConfidentialMPTMirrorUpdate.h","line":62},"definition":{"file":"include/xrpl/tx/transactors/token/ConfidentialMPTMirrorUpdate.h","line":63,"endLine":96}},"corrections":[],"templateParameters":null,"isTemplateSpecialization":false,"isFinal":false,"isAbstract":false,"baseClasses":[{"name":"xrpl::Transactor","target":{"path":"xrpl/Transactor","resolution":"doxygen"},"access":"public","isVirtual":false}],"derivedClasses":[],"friends":[],"deductionGuides":[],"nested":[],"members":["xrpl/ConfidentialMPTMirrorUpdate/kConsequencesFactory","xrpl/ConfidentialMPTMirrorUpdate/ConfidentialMPTMirrorUpdate/0cdb594d","xrpl/ConfidentialMPTMirrorUpdate/doApply/0f1d9f93","xrpl/ConfidentialMPTMirrorUpdate/visitInvariantEntry/1309601d","xrpl/ConfidentialMPTMirrorUpdate/finalizeInvariants/226ba588","xrpl/ConfidentialMPTMirrorUpdate/checkExtraFeatures/ef092c70","xrpl/ConfidentialMPTMirrorUpdate/preflight/7d5012d2","xrpl/ConfidentialMPTMirrorUpdate/calculateBaseFee/ab5405fc","xrpl/ConfidentialMPTMirrorUpdate/preclaim/a65f5cee"],"declaration":[{"text":"class ConfidentialMPTMirrorUpdate : public "},{"text":"xrpl::Transactor","target":{"path":"xrpl/Transactor","resolution":"doxygen"}}]},{"path":"xrpl/ConfidentialMPTMirrorUpdate/kConsequencesFactory","kind":"variable","name":"kConsequencesFactory","qualifiedName":"xrpl::ConfidentialMPTMirrorUpdate::kConsequencesFactory","scope":"xrpl/ConfidentialMPTMirrorUpdate","category":"production","access":"public","documentation":{"status":"absent","brief":null,"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/tx/transactors/token/ConfidentialMPTMirrorUpdate.h","line":65},"definition