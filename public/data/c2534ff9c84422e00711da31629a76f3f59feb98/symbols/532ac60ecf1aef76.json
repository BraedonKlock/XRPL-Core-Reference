{"schemaVersion":"1.0.0","commitSha":"c2534ff9c84422e00711da31629a76f3f59feb98","shard":"532ac60ecf1aef76","symbols":[{"path":"xrpl/ScopeUnlock","kind":"class","name":"ScopeUnlock","qualifiedName":"xrpl::ScopeUnlock","scope":"xrpl","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"Automatically unlocks and re-locks a unique_lock object."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"This is the reverse of a std::unique_lock object - instead of locking the mutex for the lifetime of this object, it unlocks it."}]},{"type":"paragraph","content":[{"type":"text","text":"Make sure you don't try to unlock mutexes that aren't actually locked!"}]},{"type":"paragraph","content":[{"type":"text","text":"This is essentially a less-versatile boost::reverse_lock."}]},{"type":"paragraph","content":[{"type":"text","text":"e.g."}]},{"type":"code","text":"std::mutex mut;\n\n\n\nfor (;;)\n\n{\n\n    std::unique_lock myScopedLock{mut};\n\n    // mut is now locked\n\n\n\n    ... do some stuff with it locked ..\n\n\n\n    while (xyz)\n\n    {\n\n        ... do some stuff with it locked ..\n\n\n\n        scope_unlock unlocker{myScopedLock};\n\n\n\n        // mut is now unlocked for the remainder of this block,\n\n        // and re-locked at the end.\n\n\n\n        ...do some stuff with it unlocked ...\n\n    }  // mut gets locked here.\n\n\n\n}  // mut gets unlocked here"}],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/basics/scope.h","line":196},"definition":{"file":"include/xrpl/basics/scope.h","line":197,"endLine":216}},"corrections":["attach-deduction-guides"],"templateParameters":[{"type":[{"text":"class "},{"text":"Mutex","target":{"path":"xrpl/Mutex","resolution":"doxygen"}}],"name":null,"defaultValue":null}],"isTemplateSpecialization":false,"isFinal":false,"isAbstract":false,"baseClasses":[],"derivedClasses":[],"friends":[],