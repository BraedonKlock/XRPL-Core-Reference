{"schemaVersion":"1.0.0","commitSha":"c2534ff9c84422e00711da31629a76f3f59feb98","shard":"5fc234eafc88b2b1","symbols":[{"path":"xrpl/ValidLoan","kind":"class","name":"ValidLoan","qualifiedName":"xrpl::ValidLoan","scope":"xrpl","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"Invariants: Loans are internally consistent."}],"description":[{"type":"list","ordered":true,"items":[[{"type":"text","text":"If "},{"type":"code","text":"Loan.PaymentRemaining = 0"},{"type":"text","text":" then "},{"type":"code","text":"Loan.PrincipalOutstanding = 0"},{"type":"text","text":"."}],[{"type":"text","text":"A newly-created Loan against a closed-ended vault must satisfy "},{"type":"code","text":"StartDate + PaymentInterval * PaymentRemaining < Vault.RedemptionDate"},{"type":"text","text":"."}],[{"type":"text","text":"An "},{"type":"code","text":"ltLOAN"},{"type":"text","text":" may only be created by a "},{"type":"code","text":"ttLOAN_SET"},{"type":"text","text":" transaction."}],[{"type":"text","text":"Prior to "},{"type":"code","text":"featureLendingProtocolV1_1"},{"type":"text","text":", the "},{"type":"code","text":"lsfLoanOverpayment"},{"type":"text","text":" flag on a Loan must not change. From "},{"type":"code","text":"featureLendingProtocolV1_1"},{"type":"text","text":" onward the same rule is enforced by "},{"type":"code","text":"NoModifiedUnmodifiableFields"},{"type":"text","text":"."}],[{"type":"text","text":"Under "},{"type":"code","text":"featureLendingProtocolV1_1"},{"type":"text","text":": a. An "},{"type":"code","text":"ltLOAN"},{"type":"text","text":" may only be deleted by a "},{"type":"code","text":"ttLOAN_DELETE"},{"type":"text","text":" transaction. b. If "},{"type":"code","text":"Loan.PaymentRemaining = 0"},{"type":"text","text":" then "},{"type":"code","text":"Loan.NextPaymentDueDate = 0"},{"type":"text","text":". c. The "},{"type":"code","text":"lsfLoanImpaired"},{"type":"text","text":" flag may only change through a "},{"type":"code","text":"ttLOAN_MANAGE"},{"type":"text","text":" or "},{"type":"code","text":"ttLOAN_PAY"},{"type":"text","text":" transaction. d. The "},{"type":"code","text":"lsfLoanDefault"},{"type":"text","text":" flag may only change through a "},{"type":"code","text":"ttLOAN_MANAGE"},{"type":"text","text":" transaction. Combined with "},{"type":"code","text":"NoModifiedUnmodifiableFields"},{"type":"text","text":", which rejects any clearing of "},{"type":"code","text":"lsfLoanDefault"},{"type":"text","text":", this makes the flag write-once: "},{"type":"code","text":"ttLOAN_MANAGE"},{"type":"text","text":" may set it, and no transaction may clear it. e. Interest due, computed as "},{"type":"code","text":"TotalValueOutstanding - PrincipalOutstanding - ManagementFeeOutstanding"},{"type":"text","text":", must not be negative. f. A Loan must reference a live "},{"type":"code","text":"ltLOAN_BROKER"},{"type":"text","text":", and that broker must reference a live "},{"type":"code","text":"ltVAULT"},{"type":"text","text":". g. Post-conditions for the Loan paid down by a successful "},{"type":"code","text":"ttLOAN_PAY"},{"type":"text","text":": "},{"type":"code","text":"PaymentRemaining > 0"},{"type":"text","text":" after: neither "},{"type":"code","text":"PrincipalOutstanding"},{"type":"text","text":" nor "},{"type":"code","text":"TotalValueOutstanding"},{"type":"text","text":" increases, and at least one of them strictly decreases; "},{"type":"code","text":"PaymentRemaining"},{"type":"text","text":" strictly decreases; "},{"type":"code","text":"NextPaymentDueDate"},{"type":"text","text":" advances by N * "},{"type":"code","text":"PaymentInterval"},{"type":"text","text":", N > 0. "},{"type":"code","text":"PaymentRemaining == 0"},{"type":"text","text":" after: pinned by checks 1 and 5b."}]]}],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/tx/invariants/LoanInvariant.h","line":4