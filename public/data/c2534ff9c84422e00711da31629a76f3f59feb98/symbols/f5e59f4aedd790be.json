{"schemaVersion":"1.0.0","commitSha":"c2534ff9c84422e00711da31629a76f3f59feb98","shard":"f5e59f4aedd790be","symbols":[{"path":"xrpl/AMMVote","kind":"class","name":"AMMVote","qualifiedName":"xrpl::AMMVote","scope":"xrpl","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"link","text":"AMMVote","target":{"path":"xrpl/AMMVote","resolution":"doxygen"}},{"type":"text","text":" implements AMM vote "},{"type":"link","text":"Transactor","target":{"path":"xrpl/Transactor","resolution":"doxygen"}},{"type":"text","text":"."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"This transactor allows for the TradingFee of the AMM instance be a votable parameter. Any account (LP) that holds the corresponding LPTokens can cast a vote using the new "},{"type":"link","text":"AMMVote","target":{"path":"xrpl/AMMVote","resolution":"doxygen"}},{"type":"text","text":" transaction. VoteSlots array in ltAMM object keeps track of upto eight active votes (VoteEntry) for the instance. VoteEntry contains: Account - account id that cast the vote. FeeVal - proposed fee in basis points. VoteWeight - LPTokens owned by the account in basis points. TradingFee is calculated as sum(VoteWeight_i * fee_i)/sum(VoteWeight_i). Every time "},{"type":"link","text":"AMMVote","target":{"path":"xrpl/AMMVote","resolution":"doxygen"}},{"type":"text","text":" transaction is submitted, the transactor"}]},{"type":"list","ordered":false,"items":[[{"type":"text","text":"Fails the transaction if the account doesn't hold LPTokens"}],[{"type":"text","text":"Removes VoteEntry for accounts that don't hold LPTokens"}],[{"type":"text","text":"If there are fewer than eight VoteEntry objects then add new VoteEntry object for the account."}],[{"type":"text","text":"If all eight VoteEntry slots are full, then remove VoteEntry that holds less LPTokens than the account. If all accounts hold more LPTokens then fail transaction."}],[{"type":"text","text":"If the account already holds a vote, then update VoteEntry."}],[{"type":"text","text":"Calculate and update TradingFee."}]]}],"returns":null,"notes":[{"kind":"see","content":[{"type":"url","text":"XLS30d:Governance: Trading Fee Voting Mechanism","href":"https://github.com/XRPLF/XRPL-Standards/discussions/78"}]}],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/tx/transactors/dex/AMMVote.h","line":38},"definition":{"file":"include/xrpl/tx/transactors/dex/AMMVote.h","line":39,"endLine":69}},"corrections":[],"templateParameters":null,"isTemplateSpecialization":false,"isFinal":false,"isAbstract":false,"baseClasses":[{"name":"xrpl::Transactor","target":{"path":"xrpl/Transactor","resolution":"doxygen"},"access":"public","isVirtual":false}],"derivedClasses":[],"friends":[],"deductionGuides":[],"nested":[],"members":["xrpl/AMMVote/kConsequencesFactory","xrpl/AMMVote/AMMVote/d55a259a","xrpl/AMMVote/doApply/42f0cef1","xrpl/AMMVote/visitInvariantEntry/ba840422","xrpl/AMMVote/finalizeInvariants/d9f2046c","xrpl/AMMVote/checkExtraFeatures/e82396d6","xrpl/AMMVote/preflight/22c9548b","xrpl/AMMVote/preclaim/8f073c33"],"declaration":[{"text":"class AMMVote : public "},{"text":"xrpl::Transactor","target":{"path":"xrpl/Transactor","resolution":"doxygen"}}]},{"path":"xrpl/AMMVote/kConsequencesFactory","kind":"variable","name":"kConsequencesFactory","qualifiedName":"xrpl::AMMVote::kConsequencesFactory","scope":"xrpl/AMMVote","category":"production","access":"public","documentation":{"status":"absent","brief":null,"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"include/xrpl/tx/transactors/dex/AMMVote.h","line":41},"definition":{"file":"include/xrpl/tx/transactors/dex/AMMVote.h","line":41,"endLine":null}},"corrections":[],"type":[{"text":"auto"}],"initializer":[{"text":"= "},{"text":"ConsequencesFactoryType::Normal","target":{"path":"xrpl/Transactor/ConsequencesFactoryType","fragment