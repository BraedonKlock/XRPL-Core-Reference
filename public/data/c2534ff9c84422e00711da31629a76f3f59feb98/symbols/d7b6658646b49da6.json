rection":null},{"name":"preCreditBalanceIssuer","type":[{"text":"std::int64_t"}],"array":null,"defaultValue":null,"description":null,"direction":null}],"templateParameters":null,"requiresClause":null,"explicitSpecializations":[],"qualifiers":{"isStatic":false,"isConst":false,"isConstexpr":false,"isConsteval":false,"isExplicit":false,"isInline":false,"isNoexcept":false,"isNodiscard":false,"isDeleted":false,"isDefaulted":false,"isPureVirtual":false,"isOverride":true,"isFinal":false,"virtuality":"virtual","referenceQualifier":null},"declaration":[{"text":"virtual void creditHookMPT("},{"text":"AccountID","target":{"path":"xrpl/AccountID","resolution":"doxygen"}},{"text":" const& from, "},{"text":"AccountID","target":{"path":"xrpl/AccountID","resolution":"doxygen"}},{"text":" const& to, "},{"text":"STAmount","target":{"path":"xrpl/STAmount","resolution":"doxygen"}},{"text":" const& amount, std::uint64_t preCreditBalanceHolder, std::int64_t preCreditBalanceIssuer) override"}]},{"path":"xrpl/PaymentSandbox/issuerSelfDebitHookMPT/a3e62717","kind":"function","name":"issuerSelfDebitHookMPT","qualifiedName":"xrpl::PaymentSandbox::issuerSelfDebitHookMPT","scope":"xrpl/PaymentSandbox","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"Facilitate tracking of MPT sold by an issuer owning MPT sell offer."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"Unlike IOU, MPT doesn't have bi-directional relationship with an issuer, where a trustline limits an amount that can be issued to a holder. Consequently, the credit step (last "},{"type":"link","text":"MPTEndpointStep","target":{"path":"xrpl/MPTEndpointStep","resolution":"doxygen"}},{"type":"text","text":" or "},{"type":"link","text":"BookStep","target":{"path":"xrpl/BookStep","resolution":"doxygen"}},{"type":"text","text":" buying MPT) might temporarily overflow OutstandingAmount. Limiting of a step's output amount in this case is delegated to the next step (in rev order). The next step always redeems when a holder account sells MPT (first "},{"type":"link","text":"MPTEndpointStep","target":{"path":"xrpl/MPTEndpointStep","resolution":"doxygen"}},{"type":"text","text":" or "},{"type":"link","text":"BookStep","target":{"path":"xrpl/BookStep","resolution":"doxygen"}},{"type":"text","text":" selling MPT). In this case the holder account is only limited by the step's output and it's available funds since it's transferring the funds from one account to another account and doesn't change OutstandingAmount. This doesn't apply to an offer owned by an issuer. In this case the issuer sells or self debits and is increasing OutstandingAmount. Ability to issue is limited by the issuer originally available funds less already self sold MPT amounts (MPT sell offer). Consider an example:"}]},{"type":"list","ordered":false,"items":[[{"type":"text","text":"GW creates MPT(USD) with 1,000USD MaximumAmount."}],[{"type":"text","text":"GW pays 950USD to A1."}],[{"type":"text","text":"A1 creates an offer 100XRP(buy)/100USD(sell)."}],[{"type":"text","text":"GW creates an offer 100XRP(buy)/100USD(sell)."}],[{"type":"text","text":"A2 pays 200USD to A3 with sendMax of 200XRP. Since the payment engine executes payments in reverse, OutstandingAmount overflows in "},{"type":"link","text":"MPTEndpointStep","target":{"path":"xrpl/MPTEndpointStep","resolution":"doxygen"}},{"type":"text","text":": 950 + 200 = 1,150USD. "},{"type":"link","text":"BookStep","target":{"path":"xrpl/BookStep","resolution":"doxygen"}},{"type":"text","text":" first consumes A1 offer. This reduces OutstandingAmount by 100USD: 1,150 - 100 = 1,050USD. GW offer can only be partially consumed because the initial available amount is 50USD = 1,000 - 950. "},{"type":"link","text":"BookStep","target":{"path":"xrpl/BookStep","resolution":"doxygen"}},{"type":"text","text":" limits it's output to 150USD. This in turn limits A3's send amount to 150XRP: A1 buys 100XRP and sells 100USD to A3. This doesn't change OutstandingAmount. GW buys 50XRP and sells 50USD to A3. This changes OutstandingAmount to 1,000USD."}]]}],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":{"name":"xrpl::ApplyView::issuerSelfDebitHookMPT","target":{"path":"xrpl/ApplyView/issuerSelfDebitHookMPT/74884cad","resolution":"doxygen"}}},"location":{"declaration":{"file":"include/xrpl/ledger/PaymentSandbox.h","line":220},"definition":{"file":"src/libxrpl/ledger/PaymentSandbox.cpp","line":433,"endLine":439}},"corrections":[],"role":"method","overloadSet":"xrpl/PaymentSandbox/issuerSelfDebitHookMPT","signatureKey":"xrpl::PaymentSandbox::issuerSelfDebitHookMPT(MPTIssue const&,std::uint64_t,std::int64_t)","returnType":[{"text":"void"}],"parameters":[{"name":"issue","type":[{"text":"MPTIssue","target":{"path":"xrpl/MPTIssue","resolution":"doxygen"}},{"text":" const&"}],"array":null,"defaultValue":null,"description":null,"direction":null},{"name":"amount","type":[{"text":"std::uint64_t"}],"array":null,"defaultValue":null,"description":null,"direction":null},{"name":"origBalance","type":[{"text":"std::int64_t"}],"array":null,"defaultValue":null,"description":null,"direction":null}],"templateParameters":null,"requiresClause":null,"explicitSpecializations":[],"qualifiers":{"isStatic":false,"isConst":false,"isConstexpr":false,"isConsteval":false,"isExplicit":false,"isInline":false,"isNoexcept":false,"isNodiscard":false,"isDeleted":false,"isDefaulted":false,"isPureVirtual":false,"isOverride":true,"isFinal":false,"virtuality":"virtual","referenceQualifier":null},"declaration":[{"text":"virtual void issuerSelfDebitHookMPT("},{"text":"MPTIssue","target":{"path":"xrpl/MPTIssue","resolution":"doxygen"}},{"text":" const& issue, std::uint64_t amount, std::int64_t origBalance) override"}]},{"path":"xrpl/PaymentSandbox/adjustOwnerCountHook/29eab11b","kind":"function","name":"adjustOwnerCountHook","qualifiedName":"xrpl::PaymentSandbox::adjustOwnerCountHook","scope":"xrpl/PaymentSandbox