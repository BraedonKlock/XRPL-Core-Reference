rd cap on the number of ledger entries in a single reply."}],"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/overlay/detail/Tuning.h","line":30},"definition":{"file":"src/xrpld/overlay/detail/Tuning.h","line":30,"endLine":null}},"corrections":[],"type":[{"text":"auto"}],"initializer":[{"text":"= 12288"}],"bitfield":null,"qualifiers":{"isStatic":true,"isConstexpr":true,"isMutable":false},"declaration":[{"text":"static constexpr auto kHardMaxReplyNodes = 12288"}]},{"path":"xrpl/tuning/kSendqIntervals","kind":"variable","name":"kSendqIntervals","qualifiedName":"xrpl::tuning::kSendqIntervals","scope":"xrpl/tuning","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"How many timer intervals a sendq has to stay large before we disconnect."}],"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/overlay/detail/Tuning.h","line":35},"definition":{"file":"src/xrpld/overlay/detail/Tuning.h","line":35,"endLine":null}},"corrections":[],"type":[{"text":"auto"}],"initializer":[{"text":"= 4"}],"bitfield":null,"qualifiers":{"isStatic":true,"isConstexpr":true,"isMutable":false},"declaration":[{"text":"static constexpr auto kSendqIntervals = 4"}]},{"path":"xrpl/tuning/kDropSendQueue","kind":"variable","name":"kDropSendQueue","qualifiedName":"xrpl::tuning::kDropSendQueue","scope":"xrpl/tuning","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"How many messages on a send queue before we refuse queries."}],"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/overlay/detail/Tuning.h","line":40},"definition":{"file":"src/xrpld/overlay/detail/Tuning.h","line":40,"endLine":null}},"corrections":[],"type":[{"text":"auto"}],"initializer":[{"text":"= 192"}],"bitfield":null,"qualifiers":{"isStatic":true,"isConstexpr":true,"isMutable":false},"declaration":[{"text":"static constexpr auto kDropSendQueue = 192"}]},{"path":"xrpl/tuning/kTargetSendQueue","kind":"variable","name":"kTargetSendQueue","qualifiedName":"xrpl::tuning::kTargetSendQueue","scope":"xrpl/tuning","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"How many messages we consider reasonable sustained on a send queue."}],"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/overlay/detail/Tuning.h","line":45},"definition":{"file":"src/xrpld/overlay/detail/Tuning.h","line":45,"endLine":null}},"corrections":[],"type":[{"text":"auto"}],"initializer":[{"text":"= 128"}],"bitfield":null,"qualifiers":{"isStatic":true,"isConstexpr":true,"isMutable":false},"declaration":[{"text":"static constexpr auto kTargetSendQueue = 128"}]},{"path":"xrpl/tuning/kSendQueueLogFreq","kind":"variable","name":"kSendQueueLogFreq","qualifiedName":"xrpl::tuning::kSendQueueLogFreq","scope":"xrpl/tuning","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"How often to log send queue size."}],"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/overlay/detail/Tuning.h","line":50},"definition":{"file":"src/xrpld/overlay/detail/Tuning.h","line":50,"endLine":null}},"corrections":[],"type":[{"text":"auto"}],"initializer":[{"text":"= 64"}],"bitfield":null,"qualifiers":{"isStatic":true,"isConstexpr":true,"isMutable":false},"declaration":[{"text":"static constexpr auto kSendQueueLogFreq = 64"}]},{"path":"xrpl/tuning/kCheckIdlePeers","kind":"variable","name":"kCheckIdlePeers","qualifiedName":"xrpl::tuning::kCheckIdlePeers","scope":"xrpl/tuning","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"How often we check for idle peers (seconds)."}],"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/overlay/detail/Tuning.h","line":55},"definition":{"file":"src/xrpld/overlay/detail/Tuning.h","line":55,"endLine":null}},"corrections":[],"type":[{"text":"auto"}],"initializer":[{"text":"= 4"}],"bitfield":null,"qualifiers":{"isStatic":true,"isConstexpr":true,"isMutable":false},"declaration":[{"text":"static constexpr auto kCheckIdlePeers = 4"}]},{"path":"xrpl/tuning/kMaxQueryDepth","kind":"variable","name":"kMaxQueryDepth","qualifiedName":"xrpl::tuning::kMaxQueryDepth","scope":"xrpl/tuning","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"The maximum number of levels to search."}],"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/overlay/detail/Tuning.h","line":60},"definition":{"file":"src/xrpld/overlay/detail/Tuning.h","line":60,"endLine":null}},"corrections":[],"type":[{"text":"auto"}],"initializer":[{"text":"= 3"}],"bitfield":null,"qualifiers":{"isStatic":true,"isConstexpr":true,"isMutable":false},"declaration":[{"text":"static constexpr auto kMaxQueryDepth = 3"}]},{"path":"xrpl/tuning/kReadBufferBytes","kind":"variable","name":"kReadBufferBytes","qualifiedName":"xrpl::tuning::kReadBufferBytes","scope":"xrpl/tuning","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"Size of buffer used to read from the socket."}],"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/overlay/detail/Tuning.h","line":65},"definition":{"file":"src/xrpld/overlay/detail/Tuning.h","line":65,"endLine":null}},"corrections":[],"type":[{"text":"std::size_t"}],"initializer":[{"text":"= 16384"}],"bitfield":null,"qualifiers":{"isStatic":false,"isConstexpr":true,"isMutable":false},"declaration":[{"text":"constexpr std::size_t kReadBufferBytes = 16384"}]},{"path":"xrpl/tuning/kFreeObjectsPerRequest","kind":"variable","name":"kFreeObjectsPerRequest","qualifiedName":"xrpl::tuning::kFreeObjectsPerRequest","scope":"xrpl/tuning","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"TMGetObjectByHash differential pricing."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"Honest peers ask for at most 8 hashes per call (the header, or up to 4 state + 4 tx hashes from "},{"type":"code","text":"InboundLedger::getNeededHashes()"},{"type":"text","text":"). The free tier covers them at zero cost. Beyond that, each lookup is billed: 'misses' cost much more than 'hits' because a miss does a node store seek while a hit is usually served from cache. On top of that, a size-band surcharge kicks in for larger requests so an attacker who crams a single message with thousands of hashes blows past "},{"type":"code","text":"resource::kDropThreshold"},{"type":"text","text":" and gets disconnected."}]},{"type":"paragraph","content":[{"type":"text","text":"The numbers below are picked to keep three things true given "},{"type":"code","text":"kDropThreshold = 25000"},{"type":"text","text":":"}]},{"type":"list","ordered":false,"items":[[{"type":"text","text":"Honest traffic (<= 8 objects per request) is free."}],[{"type":"text","text":"A single all-miss request at "},{"type":"code","text":"kHardMaxReplyNodes"},{"type":"text","text":" (12288) costs more than the drop threshold, so an attacker gets dropped in one message."}],[{"type":"text","text":"A peer spamming 1024-object hit-only requests gets dropped in ~19 messages — fast enough to be useful, slow enough that an honest peer momentarily sending oversized requests has time to back off. How many objects a request can ask for before per-lookup billing begins? Twice the honest peak (8) so a peer that occasionally retries a hash never trips pricing. Same value as "},{"type":"code","text":"SHAMapInnerNode::kBranchFactor"},{"type":"text","text":"; that's a coincidence, not a requirement."}]]}],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/overlay/detail/Tuning.h","line":99},"definition":{"file":"src/xrpld/overlay/detail/Tuning.h","line":99,"endLine":null}},"corrections":[],"type":[{"text":"auto"}],"initializer":[{"text":"= 16"}],"bitfield":null,"qualifiers":{"isStatic":true,"isConstexpr":true,"isMutable":false},"declaration":[{"text":"static constexpr auto kFreeObjectsPerRequest = 16"}]},{"path":"xrpl/tuning/kCostPerLookupHit","kind":"variable","name":"kCostPerLookupHit","qualifiedName":"xrpl::tuning::kCostPerLookupHit","scope":"xrpl/tuning","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"Cost of one cache-hit lookup."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"The unit; everything else is a multiple of this."}]}],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/overlay/detail/Tuning.h","line":105},"definition":{"file":"src/xrpld/overlay/detail/Tuning.h","line":105,"endLine":null}},"corrections":[],"type":[{"text":"auto"}],"initializer":[{"text":"= 1"}],"bitfield":null,"qualifiers":{"isStatic":true,"isConstexpr":true,"isMutable":false},"declaration":[{"text":"static constexpr auto kCostPerLookupHit = 1"}]},{"path":"xrpl/tuning/kCostPerLookupMiss","kind":"variable","name":"kCostPerLookupMiss","qualifiedName":"xrpl::tuning::kCostPerLookupMiss","scope":"xrpl/tuning","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"Cost of one node-store miss, in units of "},{"type":"code","text":"kCostPerLookupHit"},{"type":"text","text":"."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"A miss does a node store disk seek; a hit usually comes from cache. The 8x ratio is an order-of-magnitude guess at the latency gap on SSD-backed nodes, not a measured number. The math only requires this to be at least 2 — any smaller and a full-miss request at the hard cap wouldn't trip the drop threshold. 8 leaves headroom: if "},{"type":"code","text":"kDropThreshold"},{"type":"text","text":" goes up or "},{"type":"code","text":"kHardMaxReplyNodes"},{"type":"text","text":" comes down, the drop-on-attack property still holds without a code change."}]}],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/overlay/detail/Tuning.h","line":118},"definition":{"file":"src/xrpld/overlay/detail/Tuning.h","line":118,"endLine":null}},"corrections":[],"type":[{"text":"auto"}],"initializer":[{"text":"= 8"}],"bitfield":null,"qualifiers":{"isStatic":true,"isConstexpr":true,"isMutable":false},"declaration":[{"text":"static constexpr auto kCostPerLookupMiss = 8"}]},{"path":"xrpl/tuning/kCostBandSmall","kind":"variable","name":"kCostBandSmall","qualifiedName":"xrpl::tuning::kCostBandSmall","scope":"xrpl/tuning","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"Size-band surcharges."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"Whichever band a request's size falls into, its surcharge is added once on top of the per-lookup cost."}]},{"type":"paragraph","content":[{"type":"text","text":"The job of the surcharge is to make crossing a band edge feel like a step, not a slope. With these values, the cost roughly doubles or triples at each cliff:"}]},{"type":"code","text":"n=64: costs 48 => n=65 costs 149 (~3x jump)\nn=1024: costs 1108 => n=1025 costs 2009 (~2x jump)"},{"type":"paragraph","content":[{"type":"text","text":"The 10x step between medium and large mirrors the ~16x step between the band edges (64 -> 1024) so the cliff feels comparable at both scales."}]}],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/overlay/detail/Tuning.h","line":134},"definition":{"file":"src/xrpld/overlay/detail/Tuning.h","line":134,"endLine":null}},"corrections":[],"type":[{"text":"auto"}],"initializer":[{"text":"= 0"}],"bitfield":null,"qualifiers":{"isStatic":true,"isConstexpr":true,"isMutable":false},"declaration":[{"text":"static constexpr auto kCostBandSmall = 0"}]},{"path":"xrpl/tuning/kCostBandMedium","kind":"variable","name":"kCostBandMedium","qualifiedName":"xrpl::tuning::kCostBandMedium","scope":"xrpl/tuning","category":"production","access":"public","documentation":{"status":"absent","brief":null,"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/overlay/detail/Tuning.h","line":135},"definition":{"file":"src/xrpld/overlay/detail/Tuning.h","line":135,"endLine":null}},"corrections":[],"type":[{"text":"auto"}],"initializer":[{"text":"= 100"}],"bitfield":null,"qualifiers":{"isStatic":true,"isConstexpr":true,"isMutable":false},"declaration":[{"text":"static constexpr auto kCostBandMedium = 100"}]},{"path":"xrpl/tuning/kCostBandLarge","kind":"variable","name":"kCostBandLarge","qualifiedName":"xrpl::tuning::kCostBandLarge","scope":"xrpl/tuning","category":"production","access":"public","documentation":{"status":"absent","brief":null,"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/overlay/detail/Tuning.h","line":136},"definition":{"file":"src/xrpld/overlay/detail/Tuning.h","line":136,"endLine":null}},"corrections":[],"type":[{"text":"auto"}],"initializer":[{"text":"= 1000"}],"bitfield":null,"qualifiers":{"isStatic":true,"isConstexpr":true,"isMutable":false},"declaration":[{"text":"static constexpr auto kCostBandLarge = 1000"}]},{"path":"xrpl/tuning/kLegitHashesPerType","kind":"variable","name":"kLegitHashesPerType","qualifiedName":"xrpl::tuning::kLegitHashesPerType","scope":"xrpl/tuning","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"How many hashes per type an honest peer asks for at a time."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"Matches the "},{"type":"code","text":"4"},{"type":"text","text":" passed to "},{"type":"code","text":"neededStateHashes(4)"},{"type":"text","text":" and "},{"type":"code","text":"neededTxHashes(4)"},{"type":"text","text":" in "},{"type":"code","text":"InboundLedger::getNeededHashes()"},{"type":"text","text":". Kept here instead of imported from the ledger module so overlay stays self-contained; if that "},{"type":"code","text":"4"},{"type":"text","text":" ever changes, update this in lockstep or the band thresholds below will start charging honest peers."}]}],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/overlay/detail/Tuning.h","line":147},"definition":{"file":"src/xrpld/overlay/detail/Tuning.h","line":147,"endLine":null}},"corrections":[],"type":[{"text":"auto"}],"initializer":[{"text":"= 4"}],"bitfield":null,"qualifiers":{"isStatic":true,"isConstexpr":true,"isMutable":false},"declaration":[{"text":"static constexpr auto kLegitHashesPerType = 4"}]},{"path":"xrpl/tuning/kBandSmallMax","kind":"variable","name":"kBandSmallMax","qualifiedName":"xrpl::tuning::kBandSmallMax","scope":"xrpl/tuning","category":"production","access":"public","documentation":{"status":"present","brief":[{"type":"text","text":"Cutoffs that decide which size band a request falls into."}],"description":[{"type":"paragraph","content":[{"type":"text","text":"A "},{"type":"link","text":"SHAMap","target":{"path":"xrpl/SHAMap","resolution":"doxygen"}},{"type":"text","text":" inner node has 16 children; an honest peer asks for 4 hashes per type. So:"}]},{"type":"paragraph","content":[{"type":"text","text":"kBandSmallMax = 4 * 16 = 64 // one inner node's worth kBandMediumMax = 4 * 16^2 = 1024 // a depth-2 subtree's worth"}]},{"type":"paragraph","content":[{"type":"text","text":"A request up to 64 objects is small (no surcharge); up to 1024 is medium; anything larger is large. The bounds are inclusive: a request of exactly 64 is small, 65 is medium. Anything past 1024 is well beyond what the honest sync path produces, so it's billed at the large rate to drive attack-shaped traffic over the drop threshold quickly."}]}],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/overlay/detail/Tuning.h","line":165},"definition":{"file":"src/xrpld/overlay/detail/Tuning.h","line":165,"endLine":null}},"corrections":[],"type":[{"text":"auto"}],"initializer":[{"text":"= "},{"text":"kLegitHashesPerType","target":{"path":"xrpl/tuning/kLegitHashesPerType","resolution":"doxygen"}},{"text":" * "},{"text":"SHAMapInnerNode::kBranchFactor","target":{"path":"xrpl/SHAMapInnerNode/kBranchFactor","resolution":"doxygen"}}],"bitfield":null,"qualifiers":{"isStatic":true,"isConstexpr":true,"isMutable":false},"declaration":[{"text":"static constexpr auto kBandSmallMax = "},{"text":"kLegitHashesPerType","target":{"path":"xrpl/tuning/kLegitHashesPerType","resolution":"doxygen"}},{"text":" * "},{"text":"SHAMapInnerNode::kBranchFactor","target":{"path":"xrpl/SHAMapInnerNode/kBranchFactor","resolution":"doxygen"}}]},{"path":"xrpl/tuning/kBandMediumMax","kind":"variable","name":"kBandMediumMax","qualifiedName":"xrpl::tuning::kBandMediumMax","scope":"xrpl/tuning","category":"production","access":"public","documentation":{"status":"absent","brief":null,"description":[],"returns":null,"notes":[],"suppressionReason":null,"inheritedFrom":null},"location":{"declaration":{"file":"src/xrpld/overlay/detail/Tuning.h","line":166},"definition":{"file":"src/xrpld/overlay/detail/Tuning.h","line":166,"endLine":null}},"corrections":[],"type":[{"text":"auto"}],"initializer":[{"text":"= "},{"text":"kBandSmallMax","target":{"path":"xrpl/tuning/kBandSmallMax","resolution":"doxygen"}},{"text":" * "},{"text":"SHAMapInnerNode::kBranchFactor","target":{"path":"xrpl/SHAMapInnerNode/kBranchFactor","resolution":"doxygen"}}],"bitfield":null,"qualifiers":{"isStatic":true,"isConstexpr":true,"isMutable":false},"declaration":[{"text":"static constexpr auto kBandMediumMax = "},{"text":"kBandSmallMax","target":{"path":"xrpl/tuning/kBandSmallMax","resolution":"doxygen"}},{"text":" * "},{"text":"SHAMapInnerNode::kBranchFactor","target":{"path":"xrpl/SHAMapInnerNode/kBranchFactor","resolution":"doxygen"}}]}]}
